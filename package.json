{
  "name": "bazar-bazar",
  "private": true,
  "version": "2.0.0",
  "description": "BAZAR BAZAR — supérette tranquille en 3D, seul ou à deux (chacun sur son écran) — SuperEssence Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "android:assets": "python3 scripts/android-assets.py",
    "android:sync": "npm run build && npx cap sync android",
    "logo": "node scripts/build-logo.mjs",
    "assets": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "generaluser": "^1.47.1",
    "meshoptimizer": "^1.3.0",
    "opentype.js": "^2.0.0",
    "peer": "^1.0.2",
    "pngjs": "^7.0.0",
    "spessasynth_core": "^4.4.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
